<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_saved_widget_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/item_widget_thumb"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circular_button"
        android:contentDescription="Widget thumbnail"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_photo_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Photo Collection"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="1 Photos • Original"
            android:textColor="#94a3b8"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/item_radio_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:contentDescription="Selection radio indicator"
        android:src="@drawable/ic_radio_unchecked" />

</LinearLayout>
